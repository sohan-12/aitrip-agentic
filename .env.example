# Optional local PostgreSQL service. Use the same URL-safe password in both values.
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://aitrip:replace_with_a_local_password@127.0.0.1:5432/aitrip

# Vite reads this from the project root. Override for a custom API port.
AITRIP_API_TARGET=http://127.0.0.1:8000
